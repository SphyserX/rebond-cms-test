---
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-700.css';
import '../styles/global.css';
import { url } from '../lib/site';

interface Props {
  titre: string;
  description: string;
}

const { titre, description } = Astro.props;
const chemin = Astro.url.pathname;
const menu = [
  { nom: 'Accueil', lien: url('/'), actif: chemin === url('/') },
  { nom: 'Conseils', lien: url('/conseils/'), actif: chemin.startsWith(url('/conseils/')) },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="conteneur">
        <a class="marque" href={url('/')}>Coach démo</a>
        <nav class="menu" aria-label="Menu principal">
          <ul>
            {
              menu.map((item) => (
                <li>
                  <a href={item.lien} aria-current={item.actif ? 'page' : undefined}>
                    {item.nom}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="conteneur">
        <p>Coach démo est une marque fictive. Site de démonstration, contenu de test.</p>
      </div>
    </footer>
  </body>
</html>
